PRIVATE_KEY=
MAXIMUM_DEPOSIT_AMOUNT=1000000000000000000000
ALCHEMY_KEY=
INFURA_API_KEY=
ETHERSCAN_KEY=
INDEXER_URL=

# --- Robinhood mixer deploy (scripts/deployRobinhood.js) ---
ROBINHOOD_RPC=
ROBINHOOD_CHAIN_ID=
# admin/multisig; defaults to the deployer if unset
ADMIN_ADDRESS=
# canonical WETH and USDG token on the target chain (required on live nets)
WETH_ADDRESS=
USDG_ADDRESS=
USDG_DECIMALS=18
# Uniswap routers to allowlist (v4 = UniversalRouter). Optional; leave blank to skip.
V2_ROUTER=
V3_ROUTER=
V4_ROUTER=
# protocol fee: bps (<=1000 = 10% cap) + where it accrues (defaults to admin)
PROTOCOL_FEE_BPS=30
PROTOCOL_FEE_RECIPIENT=
# written into deployments/<network>.json for the frontend
RPC_URL=
EXPLORER_URL=
RELAYER_URL=
NATIVE_NAME=Ether
NATIVE_SYMBOL=ETH
